<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>hrsync-apphost-7d3f0c2e</UserSecretsId>
    <!-- The Aspire CLI bundle is optional; dotnet run works without it. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.Functions" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HrSync.Functions\HrSync.Functions.csproj" />
    <ProjectReference Include="..\HrSync.MockApis\HrSync.MockApis.csproj" />
  </ItemGroup>

</Project>
